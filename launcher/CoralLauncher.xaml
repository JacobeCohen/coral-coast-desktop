<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coral Launcher" Width="1040" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False"
        FontFamily="Bahnschrift" Foreground="#3B1F24"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#DBFAECDC"/>
    <SolidColorBrush x:Key="CardLine" Color="#BFFFF8F0"/>
    <SolidColorBrush x:Key="TealBrush" Color="#1D7364"/>
    <SolidColorBrush x:Key="InkBrush" Color="#3B1F24"/>
    <SolidColorBrush x:Key="InkSoftBrush" Color="#6B4A44"/>
    <SolidColorBrush x:Key="CreamBrush" Color="#FFF4EA"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E6FFF8F0"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#3C1414"/>

    <!-- plain button with a rounded hover -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- category tile (off / on) -->
    <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Width" Value="86"/>
      <Setter Property="Height" Value="80"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="TileOn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="86"/>
      <Setter Property="Height" Value="80"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{StaticResource TealBrush}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- pinned favourite -->
    <Style x:Key="Pin" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Width" Value="60"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <!-- drawer item -->
    <Style x:Key="Item" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="232"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#8CFFF8F0" BorderBrush="#1F3B1F24" BorderThickness="1" CornerRadius="14" Padding="12,0,10,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F2FFF8F0"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#661D7364"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slim scrollbar for the drawer -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#593B1F24" CornerRadius="3"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="108"/>
    </Grid.RowDefinitions>

    <!-- pop-up drawer -->
    <Border x:Name="Drawer" Grid.Row="0" Visibility="Collapsed" Margin="10,10,10,0" VerticalAlignment="Bottom"
            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
            CornerRadius="22" Padding="22,16,12,12" Effect="{StaticResource CardShadow}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,10,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="DrawerTitle" Text="Games" FontSize="34" Foreground="#7A2630" VerticalAlignment="Center"/>
            <TextBlock x:Name="DrawerCount" FontSize="13" Foreground="{StaticResource InkSoftBrush}" Margin="14,6,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="DrawerPath" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="CloseBtn" Style="{StaticResource Flat}" Width="34" Height="34" ToolTip="Close (Esc)">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12"/>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <WrapPanel x:Name="Items" Orientation="Horizontal"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- the bar -->
    <Border x:Name="Bar" Grid.Row="2" Margin="10,0,10,10"
            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
            CornerRadius="22" Padding="10,9,12,9" Effect="{StaticResource CardShadow}">
      <DockPanel LastChildFill="True">
        <StackPanel x:Name="Tiles" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"/>
        <StackPanel x:Name="Pins" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"/>
        <Border Margin="8,14,8,14" CornerRadius="18" Background="#B3FFF8F0" BorderBrush="#263B1F24" BorderThickness="1">
          <Grid Margin="14,0,14,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="14" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SearchHint" Text="Search apps and games" FontSize="15" Foreground="{StaticResource InkSoftBrush}"
                       Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="Search" Margin="22,0,0,0" FontSize="15" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" CaretBrush="{StaticResource TealBrush}"/>
          </Grid>
        </Border>
      </DockPanel>
    </Border>
  </Grid>
</Window>
